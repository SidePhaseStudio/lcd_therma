# Optional tuning
LCD_SAMPLE_SECONDS=1.0
# The panel's Bulk/LY firmware reverts to its own boot logo after ~2-3s
# without a frame (see README Troubleshooting) - this forces a cheap resend
# of the last frame on ticks where on-screen content didn't change, so a
# frame always goes out at least this often.
LCD_KEEPALIVE_SECONDS=1.0
LCD_JPEG_QUALITY=85

# Optional real-WAN startup gate. The LCD process waits for valid DNS/HTTPS
# before opening the panel so online stats populate on the first fetch.
LCD_WAN_CHECK_URL=https://www.gstatic.com/generate_204
LCD_WAN_RETRY_SECONDS=2

# Optional path to the LAN/WAN nftables counter cache (shared with the LCD project).
LCD_COUNTERS_PATH=/run/lcd-network-counters.json

# Optional external stats integrations.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCjMx6UPBC8NXfbhfiCIDIoA
TIKTOK_NEW_USERNAME=craigybabyj_new
TIKTOK_MAIN_USERNAME=craigybabyj

# Optional brightness / power-saving tuning. See README "Brightness / Power
# Saving" and "Household Presence" sections for the full behaviour.
LCD_BRIGHTNESS_FACTOR=0.7
LCD_QUIET_BRIGHTNESS_FACTOR=0.0
LCD_QUIET_START=23:59
LCD_QUIET_END=06:00
LCD_PHONE_IP=192.168.1.12
LCD_PHONE_CHECK_SECONDS=20
LCD_PHONE_AWAY_AFTER_MISSES=5

# Household "who's home" display (Crypto column) - two people's name/IP,
# kept out of the repo. PERSON1_IP_ALT is optional, for a device that lives
# on a separate isolated guest/SDN subnet and may answer on either address
# until it fully renegotiates onto its DHCP reservation (see README
# "Household Presence" for the guest-isolation firewall gotcha). Leaving an
# IP blank disables that person's check (always shows "--").
LCD_PERSON1_NAME=Person 1
LCD_PERSON1_IP=
LCD_PERSON1_IP_ALT=
LCD_PERSON2_NAME=Person 2
LCD_PERSON2_IP=
LCD_HOUSEHOLD_CHECK_SECONDS=30
LCD_HOUSEHOLD_AWAY_AFTER_MISSES=3
